# Copy this file to .env and fill in the values

# OpenAQ v3 API key; only ingest uses it, dbt never calls the API.
# NASA POWER doesn't require a key.
OPENAQ_API_KEY=

# Root of the raw data. The ingestion writes here and the dbt sources read
# from it (env_var RAW_ROOT with a default in dbt/models/staging/_sources.yml).
RAW_ROOT=data/raw

# Days of delay for NASA POWER: the meteorology (MERRA-2) is available in ~3
# days, but the hourly radiation (CERES) is published ~2 months later; the lag
# follows the slowest variable so that all partitions are complete.
INGEST_LAG_DAYS=70

# Path to the DuckDB database file. Must be the same path as in dbt/profiles.yml.
DUCKDB_PATH=data/warehouse.duckdb